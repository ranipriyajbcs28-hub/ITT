int peopleAwareOfSecret(int n, int delay, int forget) {
    unsigned int shares = 0, total = 0;
    unsigned int dp[n + 1];
    for (int i = 0; i <= n; i++) dp[i] = 0;
    
    dp[1] = 1;

    for (int i = 2; i <= n; i++) {
        shares = (shares + (i > delay ? dp[i - delay] : 0) - (i > forget ? dp[i - forget] : 0) + 1000000007) % 1000000007;
        dp[i] = shares;
    }

    for (int i = n - forget + 1; i <= n; i++) {
        if (i > 0) total = (total + dp[i]) % 1000000007;
    }

    return total;
}
