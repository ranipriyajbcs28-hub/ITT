#include <stdio.h>

int minKBitFlips(int* nums, int numsSize, int k) {
    int ans = 0;
    int current_flips = 0;

    for (int i = 0; i < numsSize; i++) {
        if (i >= k) {
            if (nums[i - k] > 1) {
                current_flips--;
            }
        }
        if ((nums[i] + current_flips) % 2 == 0) {
            if (i + k > numsSize) {
                return -1;
            }
            ans++;
            current_flips++;
            nums[i] += 2; 
        }
    }

    return ans;
}
