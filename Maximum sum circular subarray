#include <stdio.h>
int max(int a, int b) {
    return (a > b) ? a : b;
}
int min(int a, int b) {
    return (a < b) ? a : b;
}

int maxSubarraySumCircular(int* nums, int numsSize) {
    int total_sum = 0;
    int max_linear = nums[0];
    int current_max = 0;
    int min_linear = nums[0];
    int current_min = 0;
    
    for (int i = 0; i < numsSize; i++) {
        total_sum += nums[i];
        current_max = max(nums[i], current_max + nums[i]);
        max_linear = max(max_linear, current_max);
        current_min = min(nums[i], current_min + nums[i]);
        min_linear = min(min_linear, current_min);
    }
    if (max_linear < 0) {
        return max_linear;
    }
    return max(max_linear, total_sum - min_linear);
}
