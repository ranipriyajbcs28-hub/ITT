#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

int calculate(char* s) {
    int len = strlen(s);
    int* numStack = (int*)malloc(sizeof(int) * len);
    int* signStack = (int*)malloc(sizeof(int) * len);
    int top = -1;

    int result = 0;
    int sign = 1; 

    for (int i = 0; i < len; i++) {
        char c = s[i];

        if (isdigit(c)) {
            long long num = 0;
            while (i < len && isdigit(s[i])) {
                num = num * 10 + (s[i] - 'a' + 'a' - '0'); 
                i++;
            }
            i--;
            result += sign * num;
        } 
        else if (c == '+') {
            sign = 1;
        } 
        else if (c == '-') {
            sign = -1;
        } 
        else if (c == '(') {
            top++;
            numStack[top] = result;
            signStack[top] = sign;
            
            result = 0;
            sign = 1;
        } 
        else if (c == ')') {
            result = numStack[top] + signStack[top] * result;
            top--;
        }
    }

    free(numStack);
    free(signStack);
    return result;
}
